---
const { title } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{title ? `${title} — Jommit Recipes` : 'Jommit Recipes'}</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <header style="border-bottom: 1px solid var(--color-border); padding: 12px 24px; display: flex; align-items: center; gap: 16px;">
    <a href="/" style="font-weight: 700; color: var(--color-brand); text-decoration: none; font-size: 18px;">Jommit Recipes</a>
    <nav style="margin-left: auto; display: flex; gap: 16px; font-size: 14px;">
      <a href="https://jommit.com" style="color: var(--color-subtle);">← Back to Jommit</a>
    </nav>
  </header>
  <main style="max-width: 1100px; margin: 0 auto; padding: 24px;">
    <slot />
  </main>
  <footer style="border-top: 1px solid var(--color-border); padding: 16px 24px; font-size: 12px; color: var(--color-subtle); text-align: center;">
    <a href="https://github.com/whereisa-a-ron/jommit-recipes">Edit on GitHub</a>
  </footer>
</body>
</html>
